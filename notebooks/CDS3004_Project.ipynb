import numpy as np
import pandas as pd
from sklearn.metrics import precision_score, recall_score, f1_score, confusion_matrix

def evaluate_top_k_percent(y_true, y_prob, top_pct):
    # Determine probability cutoff for top K% highest risk customers
    cutoff = np.percentile(y_prob, 100 - top_pct)
    y_pred = (y_prob >= cutoff).astype(int)
    
    tn, fp, fn, tp = confusion_matrix(y_true, y_pred).ravel()
    base_rate = np.mean(y_true)
    precision = precision_score(y_true, y_pred)
    recall = recall_score(y_true, y_pred)
    lift = precision / base_rate
    
    return {
        "Target Group": f"Top {top_pct}%",
        "Prob Threshold": round(cutoff, 4),
        "Flagged Customers": int(y_pred.sum()),
        "TP (Caught Churners)": int(tp),
        "FP (False Alarms)": int(fp),
        "FN (Missed Churners)": int(fn),
        "Precision": round(precision, 4),
        "Recall": round(recall, 4),
        "F1": round(f1_score(y_true, y_pred), 4),
        "Lift": round(lift, 4)
    }

